# ThreatSentinel Frontend Environment Configuration
# ----------------------------------------------------
# Application Branding & Metadata
VITE_APP_NAME="ThreatSentinel.ai"
VITE_APP_MODE="demonstration"
VITE_APP_VERSION="2.4.0"

# Data Operation Mode:
# Set to 'mock' for standalone client-side demonstration (no backend required)
# Set to 'api' to connect to a live backend API service
VITE_DATA_MODE=mock

# Centralized Backend API Base URL
# Point this to your Node.js API Gateway or Python FastAPI service
VITE_API_BASE_URL=http://localhost:5000/api/v1
